# GoHighLevel webhook URL — paste your GHL form webhook here
NEXT_PUBLIC_GHL_WEBHOOK_URL=https://your-ghl-webhook-url-here

# Optional: Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# SimpleTexting API (get from app.simpletexting.com → Settings → API)
SIMPLETEXTING_API_KEY=your-simpletexting-api-key-here
SIMPLETEXTING_ACCOUNT_PHONE=+1your10digitnumber

# Resend email API (free at resend.com — 3,000 emails/month)
RESEND_API_KEY=re_your-resend-api-key-here

# HubSpot Private App token (free — HubSpot → Settings → Integrations → Private Apps → create one with "crm.objects.contacts.write" scope)
HUBSPOT_PRIVATE_APP_TOKEN=pat-your-hubspot-token-here

# Where sign-QR lead alerts go (instant text + email the moment someone submits a for-sale/for-rent form)
ANNIA_ALERT_EMAIL=Annia.Realty@Gmail.com
ANNIA_ALERT_PHONE=4074921114

# Anthropic Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# MLS API Keys — Phase 2 (coming soon)
STELLAR_MLS_API_KEY=your-stellar-mls-key-here
MIAMI_MLS_API_KEY=your-miami-mls-key-here
